# Copy to .env and fill in real values. Never commit .env.
# Docker Compose reads this file both for ${...} interpolation and as the
# service environment (env_file: .env).

# --- Postgres (db service) ---
POSTGRES_USER="bike_shop"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="bike_shop"

# --- App / migrations ---
DATABASE_URL="postgresql://bike_shop:change-me@db:5432/bike_shop?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://bikeshop.bicikl-kocevar.com"
AUTH_TRUST_HOST="true"
# Only used by `prisma db seed`; change before seeding.
AUTH_ADMIN_PASSWORD="change-me"

# --- MinIO (object storage for pictures) ---
MINIO_ROOT_USER="bike_shop"
MINIO_ROOT_PASSWORD="change-me"

# --- S3 (app side) ---
# Public endpoint: presigned upload URLs are handed to the browser, so this
# must be the Cloudflare Tunnel hostname for MinIO.
S3_ENDPOINT="https://files.bicikl-kocevar.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY="bike_shop"
S3_SECRET_KEY="change-me"
S3_BUCKET="bike-shop-files"
# Leave empty to serve files through the app's /api/files proxy.
NEXT_PUBLIC_S3_PUBLIC_URL=""

# --- Public app URL (inlined at build time) ---
NEXT_PUBLIC_APP_URL="https://bikeshop.bicikl-kocevar.com"
