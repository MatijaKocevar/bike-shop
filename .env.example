# --- Database ---
# Local: docker compose postgres. Production (Vercel): Neon pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bike_shop?schema=public"

# --- Auth.js (NextAuth v5) ---
# Production: AUTH_URL must be the deployed site URL (e.g. https://app.vercel.app).
AUTH_URL="https://localhost:10001"
AUTH_SECRET=""
# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend magic-link email (optional)
AUTH_RESEND_KEY=""
EMAIL_FROM="Bike Shop <onboarding@resend.dev>"
# Password for the seeded admin account (admin@test.com). Used by prisma db seed.
# Change it before exposing the site publicly.
AUTH_ADMIN_PASSWORD="admin123"

# --- Object storage (MinIO local / S3-compatible) ---
# Production: Cloudflare R2 or any S3-compatible endpoint. The endpoint must NOT
# include the bucket name (e.g. https://<account-id>.r2.cloudflarestorage.com).
S3_ENDPOINT="http://localhost:9002"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="bike-shop-files"
# Optional: when set, files are served directly from this public S3 domain.
# When unset, files are served through the app's /api/files proxy route.
NEXT_PUBLIC_S3_PUBLIC_URL=""

# --- App ---
NEXT_PUBLIC_APP_URL="https://localhost:10001"
